function [mas] = atsitiktiniai(eil_sk, stulp_sk, N)
% MASGEN Norimo dydzio atsitiktiniu skaiciu masyvo generavimas.
        switch narargin
        case 0
            eil_sk = 3;
            stulp_sk = 3;
            N = 10;
        case 1
            if eil_sk == [] && stulp_sk == []
                eil_sk = 3;
                stulp_sk = 3;
            elseif eil_sk == [] && N == []
                eil_sk = 3;
                N = 10;
            else
                stulp_sk = 3;
                N = 10;
            end
        case 2
            if eil_sk == []
                eil_sk = 3;
                mas = 1 + (N-1)*rand(eil_sk, stulp_sk);
            elseif stulp_sk == []
                stulp_sk = 3;
                mas = 1 + (N-1)*rand(eil_sk, stulp_sk);
            elseif N == []
                N = 10;
                mas = 1 + (N-1)*rand(eil_sk, stulp_sk);
            end
        case 3
            mas = 1 + (N-1)*rand(eil_sk, stulp_sk);
        end
end